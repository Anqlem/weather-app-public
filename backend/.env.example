# For local development, Spring reads secrets from src/main/resources/application-local.yml
# (gitignored, active by default). This file documents the same values as plain env vars,
# which is how you'd configure a deployed/non-local environment instead:
OPENWEATHER_API_KEY=your-openweathermap-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
APP_CORS_ORIGINS=http://localhost:3000
